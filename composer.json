{
    "name": "nails/module-category",
    "keywords":
    [],
    "homepage": "https://nailsapp.co.uk/modules/category",
    "description": "This module brings a unified categorisation system to Nails apps",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require":
    {
        "php": ">=8.3",
        "nails/common": "dev-develop",
        "nails/module-cdn": "dev-develop"
    },
    "require-dev":
    {
        "nails/module-find-replace": "dev-develop",
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.0"
    },
    "scripts":
    {
        "test": "./vendor/bin/phpunit",
        "analyse": "./vendor/bin/phpstan analyse -c .phpstan/config.neon",
        "check-migrations": "php vendor/nails/common/scripts/check-migration-numbering.php"
    },
    "autoload":
    {
        "psr-4":
        {
            "Nails\\Category\\": "src/"
        }
    },
    "extra":
    {
        "nails":
        {
            "moduleName": "category",
            "type": "module",
            "namespace": "Nails\\Category\\",
            "data":
            {}
        }
    }
}